{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*", "./worker-configuration.d.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
        "baseUrl": "src",
        "paths": {
            "$/*": ["*"],
            "$assets/*": ["assets/*"],
            "$components/*": ["components/*"],
            "$consts": ["consts.ts"],
            "$layouts/*": ["layouts/*"],
            "$styles/*": ["styles/*"]
        },
		"strictNullChecks": true
	}
}
