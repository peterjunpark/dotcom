---
import { Font } from "astro:assets";
import type { ImageMetadata } from "astro";
import Footer from "$components/Footer.astro";
import MsgArea from "$components/MsgArea.astro";
import StatusLine from "$components/StatusLine.astro";
import TabLine from "$components/TabLine.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "$consts";
import "$styles/global.css";

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	image,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <link
          rel="icon"
          type="image/svg+xml"
          href="/favicon-light.svg"
          media="(prefers-color-scheme: light)"
        />
        <link
          rel="icon"
          type="image/svg+xml"
          href="/favicon-dark.svg"
          media="(prefers-color-scheme: dark)"
        />
        <link rel="alternate icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={SITE_TITLE}
            href={new URL("rss.xml", Astro.site)}
        />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />

        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

        <meta
            name="twitter:card"
            content={image ? "summary_large_image" : "summary"}
        />
        <meta name="twitter:url" content={Astro.url} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {image && <meta name="twitter:image" content={new URL(image.src, Astro.url)} />}

        <Font cssVariable="--font-jetbrains-mono" />
    </head>
    <body>
        <div id="window" box-="square">
            <TabLine />
            <main><slot /></main>
            <div>
                <StatusLine />
                <MsgArea />
            </div>
        </div>
        <Footer />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        height: 100%;
        overflow: hidden;
    }

    body {
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
    }

    #window {
        display: flex;
        flex: 1;
        flex-direction: column;
        margin: 0 auto;
        min-height: 0;
        min-width: 0;
        overflow: hidden;
        width: min(100%, 100ch);
    }

    main {
        flex: 1;
        min-height: 0;
        min-width: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }
</style>
