---
import { SITE_TITLE } from "../consts";
import Ref from "./Ref.astro";
import LightSwitch from "./LightSwitch.astro";
---

<header>
    <div id="wordmark">
        <h2 id="title"><a href="/">{SITE_TITLE}</a></h2>
        <div id="socials" aria-label="Peter's social links">
            <a href="https://github.com/peterjunpark">󰊤<span class="sr-only">Peter's GitHub profile</span></a>
            <a href="https://linkedin.com/in/peterjunpark">󰌻<span class="sr-only">Peter's LinkedIn profile</span></a>
            <a href="mailto:email@peterjunpark.com">󰇮<span class="sr-only">Peter's email</span></a>
        </div>
    </div>
    <nav id="nav-wide" aria-label="Primary">
        <Ref href="/">home</Ref>
        <Ref href="/blog">blog</Ref>
    </nav>
    <LightSwitch />
</header>

<style>
    header {
        align-items: center;
        display: flex;
        justify-content: space-between;
        padding: 0 1ch;
    }

    #title>a {
        text-decoration: none;
    }

    #title>a::before {
        content: none;
    }

    #title>a::after {
        content: none;
    }

    #wordmark {
        display: flex;
        flex-direction: column;
    }

    nav {
        display: flex;
        flex-direction: column;
    }

    @media (min-width: 768px) {
        #wordmark {
            flex-direction: row;
            gap: 1ch;
        }
        nav {
            flex-direction: row;
            gap: 1ch;
        }
    }

    .sr-only {
        border: 0;
        padding: 0;
        margin: 0;
        position: absolute !important;
        height: 1px;
        width: 1px;
        overflow: hidden;
        /* IE6, IE7 - a 0 height clip, off to the bottom right of the visible 1px box */
        clip: rect(1px 1px 1px 1px);
        /* maybe deprecated but we need to support legacy browsers */
        clip: rect(1px, 1px, 1px, 1px);
        /* modern browsers, clip-path works inwards from each corner */
        clip-path: inset(50%);
        /* added line to stop words getting smushed together (as they go onto separate lines and some screen readers do not understand line feeds as a space */
        white-space: nowrap;
    }
</style>
