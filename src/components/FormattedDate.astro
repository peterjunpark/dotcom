---
interface Props {
	date: Date;
}

const { date } = Astro.props;
const formattedDate = date.toLocaleDateString("en-GB", {
	day: "numeric",
	month: "short",
	year: "numeric",
});
---

<time datetime={date.toISOString()}>{formattedDate}</time>

<style>
    time {
        color: var(--comment-fg);
    }
</style>
