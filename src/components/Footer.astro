---
import LightSwitch from "$components/LightSwitch.astro";

const today = new Date();
const path = "";
---

<footer>
    <div id="socials-group" aria-label="Peter's social links">
        <a href="https://github.com/peterjunpark" target="_blank">󰊤<span class="sr-only">Peter's GitHub profile</span></a>
        <a href="https://linkedin.com/in/peterjunpark" target="_blank">󰌻<span class="sr-only">Peter's LinkedIn profile</span></a>
        <a href="mailto:email@peterjunpark.com">󰇮<span class="sr-only">Peter's email</span></a>
    </div>
    <small id="copyright">󰗦 {today.getFullYear()} Peter Park</small>
    <small id="lightswitch-group"><LightSwitch /></small>
</footer>

<style>
    footer {
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: 1lh;
    }

    #socials-group {
        order: 1;
    }

    #lightswitch-group {
        order: 2;
    }

    #copyright {
        order: 3;
        width: 100%;
        text-align: center;
        margin-top: 0.5rem;
    }

    @media(min-width: 320px) {
        footer {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 0;
            justify-content: space-between;
            padding: 0 1ch;
        }
    }

    @media (min-width: 480px) {
        footer {
            flex-wrap: nowrap;
        }

        #socials-group,
        #lightswitch-group,
        #copyright {
            order: initial;
            width: auto;
            margin-top: 0;
        }
    }

    .sr-only {
        border: 0;
        padding: 0;
        margin: 0;
        position: absolute !important;
        height: 1px;
        width: 1px;
        overflow: hidden;
        clip: rect(1px 1px 1px 1px);
        clip: rect(1px, 1px, 1px, 1px);
        clip-path: inset(50%);
        white-space: nowrap;
    }
</style>
